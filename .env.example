# Set to true to load GTM + GA4 locally (otherwise only in production builds)
# VITE_ENABLE_ANALYTICS=true

# Intastellar SSO (@intastellar/signin-sdk-react) — register app + redirect domain in Intastellar console
VITE_INTASTELLAR_CLIENT_ID=
# Shown in the OAuth flow; defaults to "inta.dev" if unset
# VITE_INTASTELLAR_APP_NAME=inta.dev

# MongoDB Atlas — API keys + user_accounts (server-only; not VITE_)
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?appName=inta-dev
# Optional database name (default: inta_portal)
# MONGODB_DB=inta_portal
# Required in production: long random secret used to hash API keys (never commit real values)
# API_KEY_PEPPER=
#
# Collections: user_accounts (linked identities), api_keys (hashed secrets; optional ownerAccountId)
