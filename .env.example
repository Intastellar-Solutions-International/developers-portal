# Set to true to load GTM + GA4 locally (otherwise only in production builds)
# VITE_ENABLE_ANALYTICS=true

# Legacy migration banner (developers.intastellarsolutions.com → inta.dev): shown until end of this calendar year (UTC), then hidden for everyone. Default 2026.
# VITE_LEGACY_BANNER_UNTIL_YEAR=2026

# Intastellar SSO (@intastellar/signin-sdk-react) — register app + redirect domain in Intastellar console
VITE_INTASTELLAR_CLIENT_ID=
# Shown in the OAuth flow; defaults to "inta.dev" if unset
# VITE_INTASTELLAR_APP_NAME=inta.dev

# MongoDB Atlas — API keys + user_accounts (server-only; not VITE_)
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?appName=inta-dev
# Optional database name (default: inta_portal)
# MONGODB_DB=inta_portal
# Required in production: long random secret used to hash API keys (never commit real values)
# API_KEY_PEPPER=
#
# Collections + validators + indexes: app/lib/mongodb-schema.server.ts
# (user_accounts, api_keys, platform_status + platform_status_history for /api/status/cron)
#
# Signed HttpOnly cookie `inta_portal_sess` (set after Intastellar verify + Mongo user). Required in production:
# SESSION_SECRET=

# Changelog (/changelog): GitHub releases for Intastellar Consents
# CHANGELOG_GITHUB_REPO=owner/repo
# Changelog — Intastellar Sign-In: GitHub repo + npm package (defaults match Intastellar org)
# SIGNIN_CHANGELOG_GITHUB_REPO=Intastellar-Solutions-International/intastellar-signin
# SIGNIN_NPM_PACKAGE=@intastellar/signin-sdk-react
# Optional: higher GitHub API rate limits for changelog loaders
# GITHUB_TOKEN=
#
# Status page email alerts (/status subscribe): Resend API + verified sender. Subscribers confirm via link; unsubscribe in each email.
# RESEND_API_KEY=re_...
# STATUS_NOTIFY_FROM="inta.dev Status <status@yourdomain.com>"
# Always receive maintenance, operator-notice, and probe-failure alerts (comma-separated). Deduped if you also use /status subscribe.
# STATUS_NOTIFY_OPS_EMAILS=info@intastellar.com
# Optional: HTTPS logo URL for HTML templates (defaults to Intastellar developers wordmark on CDN)
# STATUS_NOTIFY_EMAIL_LOGO_URL=https://example.com/logo.png

# /status “Last deploy”: tip commit from this GitHub repo+ref (not the portal’s Vercel deploy). Defaults: cookie-solutions development branch.
# STATUS_DEPLOY_GITHUB_REPO=felixaschultz/intastellar-cookie-solutions
# STATUS_DEPLOY_GITHUB_REF=development

# Private status ops UI: /internal/status-ops — comma-separated emails allowed to manage maintenance + manual incident posts (requires signed-in portal user + MongoDB)
# STATUS_ADMIN_EMAILS=you@company.com,other@company.com

# Status page (/status) + Vercel Cron → /api/status/cron — requires MONGODB_URI to persist snapshots
# CRON_SECRET=long-random — required in production. In Vercel → Project → Settings → Environment Variables
# (Production): add CRON_SECRET. Vercel Cron then sends: Authorization: Bearer <CRON_SECRET> on each run.
# Local / manual trigger: npm run status:cron (optional STATUS_CRON_URL, default http://127.0.0.1:5173/api/status/cron)
# When a monitor goes from passing → failing, email goes to /status subscribers who enabled “Operator notices” (once per failure, not every minute).
# Optional JSON arrays of { "id", "name", "url", "method"? }: replace defaults or append checks
# STATUS_CHECK_TARGETS_JSON=
# STATUS_CHECK_EXTRA_JSON=
# Status history: rolling UTC window for timelines, incident log, latency, and headline uptime (Mongo TTL ~14d).
# Default 2160 hours (90 days); max 8760 (365 days). Optional cap on rows loaded per request (default 5000, max 20000).
# STATUS_HISTORY_WINDOW_HOURS=2160
# STATUS_HISTORY_MAX_ROWS=5000
#
# Multi-region status crons (same CRON_SECRET; each worker calls /api/status/cron with a distinct region):
# ?region=eu-stockholm or X-Status-Probe-Region: eu-frankfurt, or STATUS_PROBE_REGION on the server.
# If none of these are set, snapshots still store latency under results[].regions.primary (plain Vercel Cron works).
# STATUS_CANONICAL_PROBE_REGION=eu-frankfurt — history rows from this region (plus legacy rows) drive timelines & uptime %.
# STATUS_PROBE_REGION_LABELS={"eu-stockholm":"Stockholm","eu-frankfurt":"Frankfurt","us-east-1":"Washington, DC"}
#
# Scheduled maintenance windows on /status (JSON array). Each item: id, title, startsAt, endsAt (ISO 8601), optional summary,
# optional affectedTargetIds (array of monitor ids from STATUS_CHECK_TARGETS_JSON).
# Windows with endsAt in the past are omitted. Example:
# STATUS_MAINTENANCE_JSON=[{"id":"db-2026-05-01","title":"Database maintenance","summary":"Brief impact possible.","startsAt":"2026-05-01T02:00:00.000Z","endsAt":"2026-05-01T04:00:00.000Z","affectedTargetIds":["api"]}]
